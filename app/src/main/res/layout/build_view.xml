<?xml version="1.0" encoding="utf-8"?>
<com.unhappychoice.norimaki.presentation.view.BuildView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/buildLoadError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/horizontal_margin"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/build_load_error" />

        <Button
            android:id="@+id/retryBuildLoad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/build_load_retry" />
    </LinearLayout>

    <TextView
        android:id="@+id/rebuildError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="@dimen/horizontal_margin"
        android:text="@string/build_rebuild_error"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stepsView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</com.unhappychoice.norimaki.presentation.view.BuildView>
